@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using WolfLeash.Extensions
@using App = GamesOnWhales.App
@inject EventLogger Event
@inject DefaultAppLoader WildLifeApps

@if(Directory.Exists("/etc/wolf/covers"))
{
    <Offcanvas @ref="_offCanvas"
               title="Select Cover">
        <BodyTemplate>
            @foreach (var file in Directory.GetFiles("/etc/wolf/covers").Where(f => Path.GetExtension(f) == ".png"))
            {
                <div class="form-group row mb-3">
                    <ImageSelector FilePath="@file" @bind-Value="Data!.IconPngPath" @bind-Value:after="OnHideOffCanvasClick"/>
                </div>
            }
        </BodyTemplate>
    </Offcanvas>
}

<div style="width: 500px">
    @if (WildlifeApps.Count > 0)
    {
        <div class="form-group row mb-3">
            <div style="display:flex; flex-direction: row; justify-content: start; align-items: center">
                <span style="margin-right: 0.5em">Use Template:</span>
                <Dropdown Color="DropdownColor.Secondary" Size="DropdownSize.Small">
                    <DropdownToggleButton>Wildlife App</DropdownToggleButton>
                    <DropdownMenu>
                        @foreach (var app in WildlifeApps)
                        {
                            var wildlifeApp = app;
                            <DropdownItem @onclick="@(() => TemplateAppSelected(wildlifeApp))">@app.Title</DropdownItem>
                        }
                    </DropdownMenu>
                </Dropdown>
            </div>
        </div>
    }
    
    
    <EditForm EditContext="editContext" OnValidSubmit="Submit" xmlns="http://www.w3.org/1999/html">
        <DataAnnotationsValidator/>
        <div class="form-group row mb-3">
            <TextInput @bind-Value="Data!.Title" Placeholder="Title"/>
            <ValidationMessage For="() => Data!.Title"/>
        </div>
        <div class="form-group row mb-3">
            <Tooltip Title="Covers can be links to a png, or png files in /etc/wolf/covers">
                <div class="form-group row mb-3">
                    <TextInput @bind-Value="Data!.IconPngPath" Placeholder="Icon"/>
                </div>
            </Tooltip>
            <ValidationMessage For="() => Data!.IconPngPath"/>
            @if (Directory.Exists("/etc/wolf/covers"))
            {
                <Button Color="ButtonColor.Primary" @onclick="OnShowOffCanvasClick">Select Cover</Button>
            }
        </div>

        <h5>Runner Configuration:</h5>
        <div class="form-group row mb-3">
            <TextInput @bind-Value="Data!.RunnerName" Placeholder="Runner Name"/>
            <ValidationMessage For="() => Data!.RunnerName"/>
        </div>
        <div class="form-group row mb-3">
            <TextInput @bind-Value="Data!.Image" Placeholder="Image"/>
            <ValidationMessage For="() => Data!.Image"/>
        </div>

        <div class="form-group row mb-3">
            @if (Env is not null && Env.Values.Any(v => v.Contains("RUN_SWAY") || v.Contains("RUN_GAMESCOPE")))
            {
                _isSway = Env.Values.Any(e => e.Contains("RUN_SWAY=1") || e.Contains("RUN_SWAY=true"));
                <Switch Class="mt-3"
                        Value="!_isSway"
                        Label="Use GameScope instead of Sway"
                        ValueExpression="() => _isSway"
                        ValueChanged="SwitchBetweenSwayAndGameScope"/>

            }
        </div>

        <div class="form-group row mb-3">
            <Accordion Flush="true">
                <AccordionItem Title="Advanced Options">
                    <Content>
                        <div class="form-group row mb-3">
                            <div style="display:flex; flex-direction: row; justify-content: left; align-items: center">
                                <a>Start Virtual Compositor</a>
                                <CheckboxInput @bind-Value="Data!.Start_virtual_compositor"/>
                            </div>
                        </div>
                        <div class="form-group row mb-3">
                            <div style="display:flex; flex-direction: row; justify-content: left; align-items: center">
                                <a>Start Audio Server</a>
                                <CheckboxInput @bind-Value="Data!.Start_audio_server"/>
                            </div>
                        </div>
                        <div class="form-group row mb-3">
                            <div style="display:flex; flex-direction: row; justify-content: left; align-items: center">
                                <TextInput @bind-Value="Data!.Render_node" Placeholder="Render Node"/>
                                <ValidationMessage For="() => Data!.Render_node"/>
                                <RenderDeviceDropdown @bind-Value="@Data!.Render_node"/>
                            </div>
                        </div>
                        <div class="form-group row mb-3">
                            <TextArrayInput @ref="@Env" Validator="@EnvValidator" DefaultValues="@(["RUN_SWAY=true", "GOW_REQUIRED_DEVICES=/dev/input/* /dev/dri/* /dev/nvidia*"])" Placeholder="Env"/>
                        </div>
                        <div class="form-group row mb-3">
                            <TextArrayInput @ref="@Ports" Validator="@PortsValidator" Placeholder="Ports"/>
                        </div>
                        <div class="form-group row mb-3">
                            <TextArrayInput @ref="@Mounts" Validator="@MountsValidator" Placeholder="Mounts"/>
                        </div>
                        <div class="form-group row mb-3">
                            <TextArrayInput @ref="@Devices" Validator="@DevicesValidator" Placeholder="Devices"/>
                        </div>

                        <div class="form-group row mb-3">
                            <h6>Base Create Json:</h6>
                            <TextAreaInput @bind-Value="Data!.BaseCreateJson" Placeholder="Base Create Json" Rows="8"/>
                            <ValidationMessage For="() => Data!.BaseCreateJson"/>
                        </div>
                    </Content>
                </AccordionItem>
            </Accordion>
        </div>

        <div>
            <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Submit</Button>
        </div>
    </EditForm>
</div>

@code {
    private bool _isSway = true;

    private List<App> WildlifeApps = [];
    
    private Offcanvas? _offCanvas = null!;
    private async Task OnShowOffCanvasClick()
    {
        if(_offCanvas is not null)
            await _offCanvas.ShowAsync();
    }

    private async Task OnHideOffCanvasClick()
    {
        if(_offCanvas is not null)
            await _offCanvas.HideAsync();
    }

    [Parameter]
    public EventCallback<App> OnValidSubmit { get; set; }
    
    [Parameter]
    public App? AppToEdit { get; set; }

    [SupplyParameterFromForm]
    public AppFormData? Data { get; set; }
    private ValidationMessageStore? messageStore;
    private EditContext? editContext;

    protected override async Task OnInitializedAsync()
    {
        Data ??= new();
        editContext = new(Data);
        editContext.OnValidationRequested += HandleValidationRequested;
        messageStore = new(editContext);
        WildlifeApps = await WildLifeApps.GetApps();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender) return;
        if(AppToEdit is null || Data is null) return;
        
        // Map App to FormData
        Data.Title = AppToEdit.Title;
        Data.Id = AppToEdit.Id;
        Data.IconPngPath = AppToEdit.Icon_png_path;
        Data.RunnerName = AppToEdit.Runner.Name;
        Data.Image = AppToEdit.Runner.Image;
        Data.BaseCreateJson = AppToEdit.Runner.Base_create_json;
        Env.Values = AppToEdit.Runner.Env?.ToList() ?? [];
        Ports.Values = AppToEdit.Runner.Ports?.ToList() ?? [];
        Mounts.Values = AppToEdit.Runner.Mounts?.ToList() ?? [];
        Devices.Values = AppToEdit.Runner.Devices?.ToList() ?? [];
        
        StateHasChanged();
    }

    private void HandleValidationRequested(object? sender,
        ValidationRequestedEventArgs args)
    {
        messageStore?.Clear();
    }

    #region Env
    private TextArrayInput Env = null!;
    private static List<string> EnvValidator(string s)
    {
        var errors = new List<string>();

        if(!Regex.IsMatch(s, ".*=.*"))
            errors.Add("Env should be in the format VARIABLE=VALUE.");

        return errors;
    }
    #endregion

    #region Ports
    private TextArrayInput Ports = null!;
    private static List<string> PortsValidator(string s)
    {
        var errors = new List<string>();

        //TODO: Optimize Regex to include the /udp and /tcp suffix for port declaration and fail on wrong suffixes.
        if (!Regex.IsMatch(s, "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"))
            errors.Add("Port should be formated (0-65535):(0-65535)");

        return errors;
    }
    #endregion

    #region Mounts
    private TextArrayInput Mounts = null!;
    private static List<string> MountsValidator(string s)
    {
        var errors = new List<string>();

        if(!Regex.IsMatch(s, ".*:.*"))
            errors.Add("Mounts should be in the format A:B.");

        return errors;
    }
    #endregion

    #region Devices
    private TextArrayInput Devices = null!;
    private static List<string> DevicesValidator(string s)
    {
        var errors = new List<string>();
        //TODO: Add validator for Devices field.


        return errors;
    }
    #endregion

    private async Task Submit()
    {
        var newApp = new App
        {
            Title = Data!.Title,
            Id = Data!.Id ?? Guid.NewGuid().ToBase64(),
            Icon_png_path = Data!.IconPngPath,
            H264_gst_pipeline = "",
            Hevc_gst_pipeline = "",
            Av1_gst_pipeline = "",
            Opus_gst_pipeline = "",
            Support_hdr = false,
            
            Render_node = Data!.Render_node,
            Start_virtual_compositor = Data!.Start_virtual_compositor,
            Start_audio_server = Data!.Start_audio_server,
            Runner = new()
            {
                Name = Data!.RunnerName,
                Image = Data!.Image,
                Type = "docker",
                Env = Env.Values,
                Ports = Ports.Values,
                Mounts = Mounts.Values,
                Devices = Devices.Values,
                Base_create_json = Data!.BaseCreateJson
            }
        };
        
        await OnValidSubmit.InvokeAsync(newApp);
    }

    public void ResetForm()
    {
        Event.LogEvent(new ToastMessage(
            ToastType.Info,
            "",
            "Information",
            $"{DateTime.Now}",
            $"Added new App."));

        // Reset form
        Data = new();
        Env.Values = ["RUN_SWAY=true", "GOW_REQUIRED_DEVICES=/dev/input/* /dev/dri/* /dev/nvidia*"];
        Ports.Values = [];
        Mounts.Values = [];
        Devices.Values = [];
    }

    public class AppFormData
    {
        [Required(ErrorMessage = "Title is Required", AllowEmptyStrings = false)]
        [MinLength(3, ErrorMessage = "Title should be minimum 3 characters long")]
        public string Title { get; set; } = null!;
        public string? Id { get; set; } = null;
        public string IconPngPath { get; set; } = null!;
        // ReSharper disable once InconsistentNaming
        public bool Start_virtual_compositor { get; set; } = true;
        // ReSharper disable once InconsistentNaming
        public bool Start_audio_server { get; set; } = true;
        // ReSharper disable once InconsistentNaming
        public string Render_node { get; set; } = null!;
        //
        // public string H264_gst_pipeline { get; set; }
        // public string Hevc_gst_pipeline { get; set; }
        // public string Av1_gst_pipeline { get; set; }
        // public string Opus_gst_pipeline { get; set; }

        #region Runner Fields
        public string BaseCreateJson { get; set; } = new Runner().BaseCreateJson;
        [Required(ErrorMessage = "Image is Required", AllowEmptyStrings = false)]
        public string Image { get; set; } = null!;
        [Required(ErrorMessage = "Runner Name is Required", AllowEmptyStrings = false)]
        public string RunnerName { get; set; } = null!;
        #endregion
    }

    public void Dispose()
    {
        if (editContext is not null)
            editContext.OnValidationRequested -= HandleValidationRequested;
    }

    private void SwitchBetweenSwayAndGameScope()
    {
        if (_isSway)
        {
            var i = Env.Values.FindIndex(v => v.Contains("RUN_SWAY"));
            Env.Values[i] = "RUN_GAMESCOPE=true";
        }
        else
        {
            var i = Env.Values.FindIndex(v => v.Contains("RUN_GAMESCOPE"));
            Env.Values[i] = "RUN_SWAY=true";
        }
    }

    private void TemplateAppSelected(App app)
    {
        if(Data is null) return;
        Data.Title = app.Title;
        Data.Id = app.Id;
        Data.IconPngPath = app.Icon_png_path;
        Data.RunnerName = app.Runner.Name;
        Data.Image = app.Runner.Image;
        Data.BaseCreateJson = app.Runner.Base_create_json;
        Env.Values = app.Runner.Env?.ToList() ?? [];
        Ports.Values = app.Runner.Ports?.ToList() ?? [];
        Mounts.Values = app.Runner.Mounts?.ToList() ?? [];
        Devices.Values = app.Runner.Devices?.ToList() ?? [];
    }

}