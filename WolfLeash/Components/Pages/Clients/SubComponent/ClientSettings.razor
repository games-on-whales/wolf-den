@inject Api Api
@inject WolfLeashDbContext Context

<div class="d-flex flex-row mb-3">
    <div style="display:flex; flex-direction: row; justify-content: left; align-items: center">
        <a style="white-space: nowrap">User and Group Id:</a>
        <NumberInput TValue="int" @bind-Value="_formData.RunUid" Min="0" Max="2097151" Placeholder="1000" />
        <a>:</a>
        <NumberInput TValue="int" @bind-Value="_formData.RunGid" Min="0" Max="2097151" Placeholder="1000" />
    </div>
</div>

<div class="d-flex flex-row mb-3">
    <a style="white-space: nowrap">Mouse Acceleration:</a>
    <RangeInput TValue="double" @bind-Value="_formData.MouseAcceleration" Min="0.01" Max="4" Step="0.01" />
    <Badge Color="BadgeColor.Primary"
           VisuallyHiddenText="Mouse Acceleration">
        @($"{_formData.MouseAcceleration:0.00}")
    </Badge>
</div>

<div class="d-flex flex-row mb-3">
    <a style="white-space: nowrap">V-Scroll Acceleration:</a>
    <RangeInput TValue="double" @bind-Value="_formData.VScrollAcceleration" Min="0.01" Max="4" Step="0.01"/>
    <Badge Color="BadgeColor.Primary"
           VisuallyHiddenText="Mouse Acceleration">
        @($"{_formData.VScrollAcceleration:0.00}")
    </Badge>
</div>

<div class="d-flex flex-row mb-3">
    <a style="white-space: nowrap">H-Scroll Acceleration:</a>
    <RangeInput TValue="double" @bind-Value="_formData.HScrollAcceleration" Min="0.01" Max="4" Step="0.01"/>
    <Badge Color="BadgeColor.Primary"
           VisuallyHiddenText="Mouse Acceleration">
        @($"{_formData.HScrollAcceleration:0.00}")
    </Badge>
</div>

<Card>
    <CardHeader>
        Controller
    </CardHeader>
    <CardBody>
    <div class="form-group row mb-3">
        <Dropdown Color="DropdownColor.Secondary" AutoClose="true">
            <DropdownToggleButton>Add Controller Override</DropdownToggleButton>
            <DropdownMenu>
                <DropdownItem @onclick="@(_ => AddControllerOverride(Controllers_override2.AUTO))" Type="DropdownItemType.Button">Auto</DropdownItem>
                <DropdownItem @onclick="@(_ => AddControllerOverride(Controllers_override2.XBOX))" Type="DropdownItemType.Button">XBox</DropdownItem>
                <DropdownItem @onclick="@(_ => AddControllerOverride(Controllers_override2.PS))" Type="DropdownItemType.Button">PlayStation</DropdownItem>
                <DropdownItem @onclick="@(_ => AddControllerOverride(Controllers_override2.NINTENDO))" Type="DropdownItemType.Button">Nintendo</DropdownItem>
            </DropdownMenu>
        </Dropdown>
    </div>

    @foreach (var controller in _formData.ControllersOverride.Index())
    {
        var value = $"#{controller.Index + 1}: {ControllerDisplayNames[controller.Item]}";
        <div class="form-group row mb-3">
            <div style="display:flex; flex-direction: row; justify-content: left; align-items: center">
                <TextInput Disabled="true" @bind-Value="value"/>
                <Button @onclick="@(_ => { _formData.ControllersOverride.RemoveAt(controller.Index); })" Color="ButtonColor.None">
                    <Icon Name="IconName.XCircleFill" Color="IconColor.Danger"/>
                </Button>
            </div>
        </div>
    }
    </CardBody>
</Card>

<br>

<div class="d-flex flex-row mb-3">
    <Button @onclick="Save" Color="ButtonColor.Success">Save</Button>
</div>

@code {
    [Parameter, EditorRequired] public PairedClient Client { get; set; }
    private ClientSettingsFormData _formData = null!;
    [Inject] protected EventLogger EventLogger { get; set; } = default!;

    protected override Task OnInitializedAsync()
    {
        _formData = new ClientSettingsFormData()
        {
            ControllersOverride = Client.Settings.Controllers_override.ToList(),
            MouseAcceleration = Client.Settings.Mouse_acceleration,
            VScrollAcceleration = Client.Settings.V_scroll_acceleration,
            HScrollAcceleration = Client.Settings.H_scroll_acceleration,
            RunGid = Client.Settings.Run_gid,
            RunUid = Client.Settings.Run_uid
        };
        return Task.CompletedTask;
    }

    private Dictionary<Controllers_override2, string> ControllerDisplayNames { get; set; } = new()
    {
        { Controllers_override2.AUTO, "Auto" },
        { Controllers_override2.XBOX , "XBox" },
        { Controllers_override2.PS, "Playstation"},
        { Controllers_override2.NINTENDO, "Nintendo"}
    };

    private void AddControllerOverride(Controllers_override2 controller)
    {
        _formData.ControllersOverride.Add(controller);
    }

    private async Task Save()
    {
        await Api.GeneratedClient.SettingsAsync(new UpdateClientSettingsRequest()
        {
            Client_id = Client.Client_id,
            App_state_folder = Client.App_state_folder,
            Settings = new PartialClientSettings()
            {
                Mouse_acceleration = _formData.MouseAcceleration,
                H_scroll_acceleration = _formData.HScrollAcceleration,
                V_scroll_acceleration = _formData.VScrollAcceleration,
                Run_gid = _formData.RunGid,
                Run_uid = _formData.RunUid,
                AdditionalProperties = new Dictionary<string, object>() // Todo: Change to Correct typed field when the binding is Fixed.
                {
                    { "controllers_override", _formData.ControllersOverride.Select(co => co.ToString()).ToArray() }
                }
            }
        });

        var dbClient = Context.Clients.FirstOrDefault(c => c.Id == Client.Client_id);
        EventLogger.LogEvent(new ToastMessage(ToastType.Info,
                "",
                "Settings Saved",
                $"{DateTime.Now}",
                $"Saved Settings for: {(string.IsNullOrEmpty(dbClient?.Alias) ? Client.Client_id : dbClient.Alias)}."
            )
        );
    }
    
    private class ClientSettingsFormData
    {
        public List<Controllers_override2> ControllersOverride { get; init; } = [];
        public double MouseAcceleration { get; set; } = 1.0;
        public double VScrollAcceleration { get; set; } = 1.0;
        public double HScrollAcceleration { get; set; } = 1.0;
        public int RunUid { get; set; } = 1000;
        public int RunGid { get; set; } = 1000;
    }
}