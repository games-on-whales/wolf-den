@using System.ComponentModel.DataAnnotations
@inject WolfLeashDbContext Context

<div>
    <div style="display:flex; flex-direction: row; justify-content: left; align-items: center">
        @if (_enableEdit)
        {
            <TextInput @onkeyup="@OnKeyUp" @bind-Value="@_inputText" Placeholder="@Placeholder"/>
            <a @onclick="@OnSave"> <Icon Name="IconName.Floppy"/></a>
        }
        else
        {
            @Text
            <a @onclick="() => _enableEdit = true"> <Icon Name="IconName.Pencil"/></a>
        }
    </div>
</div>
@code {
    [Parameter, EditorRequired] public string Placeholder { get; set; }
    [Parameter, EditorRequired] public string Text { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    
    private string _inputText = "";
    private bool _enableEdit = false;

    private async Task OnKeyUp(KeyboardEventArgs args)
    {
        if (args.Code is "Enter" or "NumpadEnter")
        {
            if (string.IsNullOrEmpty(_inputText))
            {
                _enableEdit = false;
                await OnSubmit.InvokeAsync(_inputText);
                return;
            }
            Text = _inputText;
            await OnSubmit.InvokeAsync(_inputText);
            await TextChanged.InvokeAsync(Text);
            _enableEdit = false;
            //await OnSave();
        }
    }

    private async Task OnSave()
    {
        if (string.IsNullOrEmpty(_inputText))
        {
            _enableEdit = false;
            await OnSubmit.InvokeAsync(_inputText);
            return;
        }
        Text = _inputText;
        await OnSubmit.InvokeAsync(_inputText);
        await TextChanged.InvokeAsync(Text);
        _enableEdit = false;
    }
}