<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>
        
    <ItemGroup>
        <PackageReference Include="GamesOnWhales.Wolf.Net.Bindings" Version="0.1.6-alpha" />
        
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageReference Include="Blazor.Bootstrap" Version="4.0.0" />
        <PackageReference Include="BlazorExpress.ChartJS" Version="1.2.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <PackageReference Include="EntityFrameworkCore.Exceptions.Sqlite" Version="10.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>

        <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
        <PackageReference Include="SharpCompress" Version="0.50.4" />
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>
        
    <ItemGroup>
      <Folder Include="DockerOverlay\etc\cont-shutdown.d\" />
    </ItemGroup>
          
    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>
</Project>
